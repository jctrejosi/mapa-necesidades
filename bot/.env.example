# Clave de la API de DeepSeek (obligatoria para el chat)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Backend de SolidaridadCO (NestJS) — el bot guarda/consulta a través de su API
BACKEND_URL=http://localhost:3000

# Puerto del bot
BOT_API_PORT=8000

# Orígenes permitidos por CORS (frontends)
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:8443
