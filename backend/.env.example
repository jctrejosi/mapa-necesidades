# PostgreSQL — Supabase (proyecto)
# Conexión vía pooler (IPv4). El usuario del pooler es postgres.<ref> y el
# password va URL-encoded (@ → %40).
DATABASE_URL=postgresql://postgres.idiypzqlbjeqgphjlabz:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/redsolidaria_db?pgbouncer=true
DB_SSL=true

# Contraseña del panel de administración
ADMIN_PASSWORD=admin123

# Puerto HTTP del backend
PORT=3000

# Carpeta donde se guardan las imágenes (solo respaldo local; por defecto Cloudinary)
UPLOAD_DIR=./uploads

# Orígenes del frontend permitidos por CORS (cliente y admin)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8443,http://localhost:8444

# Cloudinary — subida de imágenes (en la DB solo se guarda la URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business Cloud API (Meta) — confirmaciones de reportes por WhatsApp
# Sin estas credenciales, los envíos se omiten silenciosamente.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FRONTEND_URL=http://localhost:8080
