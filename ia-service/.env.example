# Credenciales de DeepSeek (igual que el bot, pero propias de este servicio).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=30

# Puerto del servicio (8100 para no chocar con bot=8000 ni backend=3000).
IA_SERVICE_PORT=8100

# Orígenes permitidos (el backend llama por HTTP interno; CORS casi no aplica).
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:8081
